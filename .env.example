# Copy to .env for local `vercel dev` — never commit real values.

GOOGLE_WORKSPACE_CLIENT_EMAIL=
GOOGLE_WORKSPACE_PRIVATE_KEY=
GOOGLE_WORKSPACE_IMPERSONATED_ADMIN_EMAIL=
GOOGLE_ANDROID_BETA_GROUP_EMAIL=android-beta@kamisocial.com

SUPABASE_URL=
# Preferred for partner venue photos — same secret as Supabase edge functions (nearby-places / place-kami-image).
PLACE_PHOTO_SIGNING_SECRET=
# Optional fallback for /api/partner/media-urls when PLACE_PHOTO_SIGNING_SECRET is unset.
SUPABASE_SERVICE_ROLE_KEY=
# Required for `npm run dev:portal` (vercel dev) so /api/partner/* routes work locally.
SUPABASE_ANON_KEY=

# Resend — ambassador welcome email (server-side only)
RESEND_API_KEY=
# Set to "false" to disable welcome sends without removing the key
AMBASSADOR_WELCOME_EMAIL_SEND_ENABLED=true

# Email delivery log ingest (main monorepo log-email-delivery edge function)
EMAIL_DELIVERY_LOG_INGEST_SECRET=

# Password-protected /model page (server-side only; never expose in browser code)
# Set these in Vercel → Project → Settings → Environment Variables for
# Development, Preview, and Production. Local `vercel dev` inherits shell env
# and/or `vercel env pull` into .env.local — plain `npm run serve` cannot protect /model.
MODEL_PAGE_PASSWORD=
# Long random secret used to sign the HttpOnly session cookie (e.g. openssl rand -hex 32)
MODEL_SESSION_SECRET=
# Full Google Sheets URL (include gid for the target tab)
MODEL_SHEET_URL=
